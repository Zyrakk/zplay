FROM --platform=$BUILDPLATFORM golang:1.22-alpine AS builder
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOARCH=$TARGETARCH go build -ldflags "-X main.Version=$VERSION -s -w" -o /zplay-dashboard ./cmd/zplay-dashboard

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /zplay-dashboard /zplay-dashboard
EXPOSE 8080
ENTRYPOINT ["/zplay-dashboard"]
